#!/usr/bin/env bash

set -e

# NOTE: The canonical source for this file is in the metabase/metabase repository.
# Please update it there then copy to the metabase/metabase-deploy repository.

# Translate various Heroku environment variables to Metabase equivalents

if [ "$PORT" ]; then
    export MB_JETTY_PORT="$PORT"
fi

# Heroku Postgres
if [ "$DATABASE_URL" ]; then
    if [[ "$DATABASE_URL" == *"?"* ]]; then
        # if DATABASE_URL already has a query string don't mess with it
        export MB_DB_CONNECTION_URI="$DATABASE_URL"
    else
        # otherwise add the SSL parameters to ensure upgraded databases work on Heroku
        export MB_DB_CONNECTION_URI="$DATABASE_URL?ssl=true&sslmode=require&sslfactory=org.postgresql.ssl.NonValidatingFactory"
    fi
fi

# Mailgun (Heroku)
if [ "$MAILGUN_SMTP_LOGIN" ]; then
    export MB_EMAIL_SMTP_HOST="$MAILGUN_SMTP_SERVER"
    export MB_EMAIL_SMTP_PORT="$MAILGUN_SMTP_PORT"
    export MB_EMAIL_SMTP_USERNAME="$MAILGUN_SMTP_LOGIN"
    export MB_EMAIL_SMTP_PASSWORD="$MAILGUN_SMTP_PASSWORD"
fi

# SendGrid (Heroku)
if [ "$SENDGRID_USERNAME" ]; then
    export MB_EMAIL_SMTP_HOST="smtp.sendgrid.net"
    export MB_EMAIL_SMTP_PORT="587"
    export MB_EMAIL_SMTP_USERNAME="$SENDGRID_USERNAME"
    export MB_EMAIL_SMTP_PASSWORD="$SENDGRID_PASSWORD"
    export MB_EMAIL_SMTP_SECURITY="tls"
fi

# Mandrill (Heroku)
if [ "$MANDRILL_USERNAME" ]; then
    export MB_EMAIL_SMTP_HOST="smtp.mandrillapp.com"
    export MB_EMAIL_SMTP_PORT="587"
    export MB_EMAIL_SMTP_USERNAME="$MANDRILL_USERNAME"
    export MB_EMAIL_SMTP_PASSWORD="$MANDRILL_APIKEY"
fi

# Postmark (Heroku)
# NOTE: requires configuring sender signature for "from" address
if [ "$POSTMARK_API_TOKEN" ]; then
    export MB_EMAIL_SMTP_HOST="$POSTMARK_SMTP_SERVER"
    export MB_EMAIL_SMTP_PORT="25"
    export MB_EMAIL_SMTP_USERNAME="$POSTMARK_API_TOKEN"
    export MB_EMAIL_SMTP_PASSWORD="$POSTMARK_API_TOKEN"
    export MB_EMAIL_SMTP_SECURITY="tls"
fi

# SparkPost (Heroku)
# NOTE: requires additional configuration
if [ "$SPARKPOST_SMTP_USERNAME" ]; then
    export MB_EMAIL_SMTP_HOST="$SPARKPOST_SMTP_HOST"
    export MB_EMAIL_SMTP_PORT="$SPARKPOST_SMTP_PORT"
    export MB_EMAIL_SMTP_USERNAME="$SPARKPOST_SMTP_USERNAME"
    export MB_EMAIL_SMTP_PASSWORD="$SPARKPOST_SMTP_PASSWORD"
fi

# AWS Elastic Beanstalk w/ RDS
if [ ! -z "$RDS_HOSTNAME" ]; then
    # EEK: this is a bit fragile.  if user picks a non-standard port for their db we are screwed :(
    if [ "$RDS_PORT" == "3306" ]; then
        export MB_DB_TYPE=mysql
    else
        export MB_DB_TYPE=postgres
    fi

    export MB_DB_DBNAME=$RDS_DB_NAME
    export MB_DB_USER=$RDS_USERNAME
    export MB_DB_PASS=$RDS_PASSWORD
    export MB_DB_HOST=$RDS_HOSTNAME
    export MB_DB_PORT=$RDS_PORT
fi

# Determine whether we're running inside a Scalingo container.
#
# Scalingo injects $CONTAINER_MEMORY (container RAM, in bytes) and $CONTAINER_SIZE
# (S, M, L, XL, ...), so there is nothing to set by hand.
#
# Scalingo's buildpack-jvm-common already exported JAVA_OPTS and JAVA_TOOL_OPTIONS
# with an -XX:MaxRAM taken from the cgroup limit, plus a heap size: a hardcoded -Xmx
# for S/M/L/XL (59% of the container on M, up to 75% on XL) and, for any other size
# (2XL, 3XL), -XX:MaxRAMPercentage=80.0. Both are too greedy for Metabase: none of
# them leaves room for the metaspace Clojure fills, nor for the ~8% of native
# overhead a G1 heap carries on top of itself.
#
# So we size every area here instead, from $CONTAINER_MEMORY alone, and the same
# rule applies to every container size. The buildpack's flags still come first, ours
# are appended, and the last -Xmx on the command line wins -- which is also why no
# per-app JAVA_OPTS override is needed any more.
#
# The budget is built so that the heap plus *every* ceiling below plus the JVM's own
# fixed cost stays under the container limit. The point is not to squeeze the last
# megabyte out, it is that a runaway area hits a JVM OutOfMemoryError -- which
# -XX:+ExitOnOutOfMemoryError below turns into a clean restart -- instead of a silent
# SIGKILL from the kernel, which leaves nothing to diagnose.

if [ -n "$CONTAINER_MEMORY" ]; then
    container_mb=$((CONTAINER_MEMORY / 1024 / 1024))

    # Metaspace and code cache are properties of the application, not of the
    # container: Metabase loads the same classes and JITs the same code whether it
    # runs on L or on 3XL. Sizing them per container size is what made 320m look
    # reasonable on 2XL, and integration then died on it with an OutOfMemoryError:
    # Metaspace. They are constants, and they form the fixed cost a container has to
    # clear before it can host Metabase at all.
    #
    # Keep them roomy: combined with -XX:+ExitOnOutOfMemoryError below, a ceiling set
    # too low does not degrade the app, it stops it from booting.
    metaspace=512   # Clojure generates a class per fn, and every driver adds its own
    codecache=192   # A full code cache silently disables the JIT

    # These two do follow the container: they scale with the thread count, hence with
    # the load the container is sized for.
    if   [ "$container_mb" -ge 4096 ]; then direct=128; jvm_base=160
    elif [ "$container_mb" -ge 2048 ]; then direct=96;  jvm_base=128
    else                                    direct=64;  jvm_base=96
    fi

    # Two terms above are estimates rather than enforced ceilings: $jvm_base, and the
    # G1 overhead below. Keep 5% of the container aside so being wrong about either
    # eats into slack instead of into the kernel's patience.
    reserve=$((container_mb / 20))

    # Whatever is left over goes to the heap, minus G1's own native cost (remembered
    # sets, mark bitmap, card table), which runs at roughly 8% of the heap it manages.
    # So heap * 1.08 = what remains, hence the /108.
    heap=$(((container_mb - metaspace - codecache - direct - jvm_base - reserve) * 100 / 108))
    if [ "$heap" -lt 384 ]; then
        # Below XL, Metabase's fixed cost leaves too little for a usable heap, and the
        # invariant above simply cannot hold. Emitting the computed -Xmx here would
        # produce a heap too small to serve anything -- worse than the over-commit it
        # avoids. So fall back to a flat share of the container, close to what the
        # budget yields on XL, and downgrade the ceilings to what they can still be on
        # this size: crash guards that turn a runaway area into a named error instead
        # of a SIGKILL. They no longer guarantee the container is never overrun.
        heap=$((container_mb * 47 / 100))
        echo "  -> WARNING: a ${CONTAINER_SIZE:-${container_mb}m} container cannot hold Metabase's fixed cost"
        echo "  -> WARNING: (metaspace ${metaspace}m + code cache ${codecache}m + ${jvm_base}m base) next to a usable heap"
        echo "  -> WARNING: falling back to -Xmx${heap}m; the ceilings are crash guards only here, OOM-kill stays possible"
        echo "  -> WARNING: use XL or larger to get a guaranteed budget"
    fi

    echo "  -> Scalingo container detected (size: ${CONTAINER_SIZE:-unknown}, ${container_mb}m)"
    echo "  -> JVM budget: heap ${heap}m + metaspace ${metaspace}m + code cache ${codecache}m + direct ${direct}m + ~$((heap * 8 / 100))m G1 + ${jvm_base}m base + ${reserve}m spare"

    JAVA_OPTS+=" -Xmx${heap}m"                            # Wins over the buildpack's own -Xmx / MaxRAMPercentage, whichever applies
    JAVA_OPTS+=" -XX:MaxMetaspaceSize=${metaspace}m"      # Unbounded metaspace is the main OOM-kill cause: Clojure generates a lot of classes
    JAVA_OPTS+=" -XX:ReservedCodeCacheSize=${codecache}m" # A full code cache silently disables the JIT, so stay well above what Metabase needs
    JAVA_OPTS+=" -XX:MaxDirectMemorySize=${direct}m"      # NIO buffers (Jetty I/O, JDBC drivers) are allocated outside the heap
    JAVA_OPTS+=" -Xss512k"                                # The buildpack only sets this on S and M containers
    JAVA_OPTS+=" -XX:+UseG1GC"                            # G1GC seems to use slightly less memory in my testing...
    JAVA_OPTS+=" -XX:+UseStringDeduplication"             # Especially when used in combination with string deduplication
fi

# Other Java options
JAVA_OPTS+=" -Djava.awt.headless=true" # don't try to start AWT. Not sure this does anything but better safe than wasting memory
JAVA_OPTS+=" -Dfile.encoding=UTF-8"    # Use UTF-8

# Set timezone using the JAVA_TIMEZONE variable if present
if [ -n "$JAVA_TIMEZONE" ]; then
    echo "  -> Timezone setting detected: $JAVA_TIMEZONE"
    JAVA_OPTS+=" -Duser.timezone=$JAVA_TIMEZONE"
fi
# Exit on the first OutOfMemoryError rather than carrying on with a JVM in an
# undefined state: threads that died mid-operation (Quartz, sync) silently stop
# working while the app still answers, which is worse than a restart. See c561e50.
JAVA_OPTS+=" -XX:+ExitOnOutOfMemoryError"

exec java $JAVA_OPTS -jar ./target/uberjar/metabase.jar
