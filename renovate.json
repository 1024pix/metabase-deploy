{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>1024pix/renovate-config:buildpack-project"
    ],
    "enabled": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^.buildpacks$/"
            ],
            "matchStrings": [
                "https://github.com/1024pix/metabase-buildpack#v(?<currentValue>\\S+)\\n?"
            ],
            "depNameTemplate": "1024pix/metabase-buildpack",
            "datasourceTemplate": "github-tags",
            "extractVersionTemplate": "v(?<version>.*)"
        }
    ]
}
